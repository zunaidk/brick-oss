# ---- Required -----------------------------------------------------------------
# Public hostname the app is served on (no scheme). User pages live on *.BRICK_HOST,
# so point a wildcard DNS record at the server if you want subdomain publishing.
BRICK_HOST=brick.example.com
# Postgres password for the bundled database
DB_PASSWORD=change-me
# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# ---- Optional -----------------------------------------------------------------
# Host port the stack publishes on 127.0.0.1 (your TLS proxy forwards here)
HOST_PORT=8080
# Cookie domain (defaults to BRICK_HOST). Use ".brick.example.com" to share auth with subdomains.
#BRICK_COOKIE_DOMAIN=
# Public IP of this server; used to verify DNS for custom domains
#BRICK_IP=
# Banner text shown in the app client (build-time)
#BRICK_CLIENT_BANNER=

# Separate secrets for email-confirmation / change-email tokens (default to JWT_SECRET)
#CONFIRM_EMAIL_JWT_SECRET=
#CHANGE_EMAIL_SECRET=

# Transactional email (sign-up confirmation, password reset) via Mailjet.
# Without it, set SKIP_EMAIL_VERIFICATION=true so new accounts do not wait for a confirmation email.
#SKIP_EMAIL_VERIFICATION=true
#MAILJET_API_KEY=
#MAILJET_SECRET_KEY=
# Sender shown on outgoing mail; must be a verified sender/domain in Mailjet (default robot@BRICK_HOST)
#EMAIL_FROM_ADDRESS=
#EMAIL_FROM_NAME=Brick

# Image uploads (any S3-compatible storage). Uploads are disabled until all are set.
#IMAGE_UPLOAD_S3_ENDPOINT=
#IMAGE_UPLOAD_S3_CDN_ENDPOINT=
#IMAGE_UPLOAD_S3_BUCKET_NAME=
#IMAGE_UPLOAD_S3_REGION=
#IMAGE_UPLOAD_S3_KEY_ID=
#IMAGE_UPLOAD_S3_SECRET_KEY=
#IMAGE_UPLOAD_S3_FORCE_PATH_STYLE=true

# Social login
#OAUTH_GITHUB_CLIENT_ID=
#OAUTH_GITHUB_CLIENT_SECRET=
#OAUTH_GOOGLE_CLIENT_ID=
#OAUTH_GOOGLE_CLIENT_SECRET=

# Paid plans (price IDs were stripped from the OSS export; leave unset for a free instance)
#STRIPE_API_KEY=
#STRIPE_ENDPOINT_SECRET=

# Let's Encrypt account for custom-domain certificates issued by the server itself.
# Not usable behind a TLS-terminating proxy; leave unset on xCloud.
#ACME_EMAIL=
#ACME_ACCOUNT_KEY=

#HELPCRUNCH_API_KEY=
# Log every SQL query (very verbose)
#DB_LOGGING=true
