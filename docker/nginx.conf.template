# Internal reverse proxy for the Brick compose stack. Listens on port 80 inside the network;
# the host's proxy (xCloud nginx) terminates TLS and forwards to the published port.
# Routing mirrors traefik-local/config/traefik_dynamic.yaml (the original production layout).

upstream brick_server   { server server:3000; }
upstream brick_socket   { server server:3002; }
upstream brick_landing  { server landing:4001; }

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Is this request for the main app host (as opposed to a user subdomain or custom domain)?
map $host $brick_is_app_host {
    default              0;
    "${BRICK_HOST}"      1;
    "www.${BRICK_HOST}"  1;
}

# Logged-in users have an authToken cookie
map $http_cookie $brick_logged_in {
    default            0;
    "~*authToken="     1;
}

# "/" on the app host for logged-out visitors goes to the marketing landing page
map "$brick_is_app_host:$brick_logged_in" $brick_root_upstream {
    default  brick_server;
    "1:0"    brick_landing;
}

# Landing assets and pages only exist on the app host
map $brick_is_app_host $brick_landing_upstream {
    default  brick_server;
    1        brick_landing;
}

server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 64m;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 300s;

    # Realtime collaboration (socket.io over websocket)
    location /api/socket.io {
        proxy_pass http://brick_socket;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /api { proxy_pass http://brick_server; }

    # Landing (Next.js) routes
    location /_next/          { proxy_pass http://$brick_landing_upstream; }
    location /landing-assets/ { proxy_pass http://$brick_landing_upstream; }
    location = /pricing       { proxy_pass http://$brick_landing_upstream; }
    location = /features      { proxy_pass http://$brick_landing_upstream; }

    location = / { proxy_pass http://$brick_root_upstream; }

    # Everything else: app client, user subdomains, public pages
    location / { proxy_pass http://brick_server; }
}
